#!/bin/bash

set -u

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
REPO_DIR=/opt/Python-Processing-InfluxDB
RUN_SCRIPT="$REPO_DIR/run_script.sh"
LOGROTATE_SOURCE="$REPO_DIR/deploy/logrotate/python-auswertung"
LOGROTATE_TARGET=/etc/logrotate.d/python-auswertung
SUMMARY_FILE=/var/log/Python_Auswertung/runs.log
LOCK_FILE=/run/lock/python-auswertung-launcher.lock
STARTED_AT=$(date --iso-8601=seconds)
STARTED_EPOCH=$(date +%s)

summary_value() {
    printf '%s' "$1" | tr '\r\n\t ' '____' | tr -s '_'
}

write_error_summary() {
    local step=$1
    local message=$2
    local duration=$(( $(date +%s) - STARTED_EPOCH ))
    mkdir -p "$(dirname "$SUMMARY_FILE")"
    printf '%s | ERROR | Fehler in %s (LauncherError): %s | Dauer: %s s\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" "$(summary_value "$step")" "$(summary_value "$message")" "$duration" >> "$SUMMARY_FILE"
}

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    exit 0
fi

if ! cd "$REPO_DIR"; then
    write_error_summary "repository" "cannot change to repository directory"
    exit 1
fi

if ! git pull --ff-only origin master; then
    write_error_summary "git_pull" "git pull --ff-only origin master failed"
    exit 1
fi

if [ ! -f "$LOGROTATE_SOURCE" ]; then
    write_error_summary "logrotate_source" "logrotate source file is missing"
    exit 1
fi

if ! cmp -s "$LOGROTATE_SOURCE" "$LOGROTATE_TARGET" 2>/dev/null; then
    if ! install -D -m 0644 "$LOGROTATE_SOURCE" "$LOGROTATE_TARGET"; then
        write_error_summary "logrotate_install" "could not install logrotate rule"
        exit 1
    fi
fi

if ! logrotate -d /etc/logrotate.conf >/dev/null; then
    write_error_summary "logrotate_validation" "logrotate dry-run failed"
    exit 1
fi

if [ ! -x "$RUN_SCRIPT" ]; then
    write_error_summary "application_start" "run_script.sh is missing or not executable"
    exit 1
fi

exec "$RUN_SCRIPT"
