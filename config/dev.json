{
    "processing": {
        "input_bucket": "HomeAssistant",
        "output_bucket": "testing",
        "entities_to_process": {
            "fix_waermepumpe_stromverbrauch": {
                "version": "v1",
                "output_measurement": "fix_waermepumpe_stromverbrauch",
                "entities": [
                    "e3_vitocal_heizung_stromverbrauch_heute",
                    "e3_vitocal_heizung_stromverbrauch_heute_2"
                ]
            },
            "daily_aggregate": {
                "output_measurement": "Waermepumpe_statistik",
                "output_entity_id": "Gesamt",
                "version": "v1",
                "entities": [
                    "e3_vitocal_heizung_stromverbrauch_heute",
                    "e3_vitocal_heizung_stromverbrauch_heute_2"
                ]
            },
            "Waermepumpe_statistik": {
                "version": "v2",
                "source_version": "v1",
                "compressor_post_run_minutes": 15,
                "emit_daily_summary": true,
                "output_measurement": "Waermepumpe_statistik",
                "output_entity_id": "Gesamt",
                "sensors": {
                    "heat_pump_1_counter": {
                        "measurement": "kWh",
                        "entity_id": "e3_vitocal_heizung_stromverbrauch_heute",
                        "field": "value",
                        "unit": "kWh"
                    },
                    "heat_pump_2_counter": {
                        "measurement": "kWh",
                        "entity_id": "e3_vitocal_heizung_stromverbrauch_heute_2",
                        "field": "value",
                        "unit": "kWh"
                    },
                    "grid_power": {
                        "measurement": "W",
                        "entity_id": "fems_gridactivepower",
                        "field": "value",
                        "unit": "W"
                    },
                    "compressor_1": {
                        "measurement": "binary_sensor.e3_vitocal_kompressor",
                        "entity_id": "e3_vitocal_kompressor",
                        "field": "value",
                        "unit": "state"
                    },
                    "compressor_2": {
                        "measurement": "binary_sensor.e3_vitocal_kompressor_2",
                        "entity_id": "e3_vitocal_kompressor_2",
                        "field": "value",
                        "unit": "state"
                    }
                }
            }
        }
    },
    "scenarios": {
        "setup": {
            "bucket": "testing",
            "input_bucket": "HomeAssistant",
            "base_storage_capacity_kWh": 22.4,
            "base_charging_power_kW": 17.92
        },
        "8_modules_2_towers": {
            "name": "8_modules_2_towers",
            "measurement": "scenario",
            "version": "v1",
            "description": "Scenario with 8 additional modules in 2 towers",
            "extra_storage_capacity_kWh": 22.4,
            "extra_charging_power_kW": 0.0
        },
        "7_modules_1_tower": {
            "name": "7_modules_1_tower",
            "measurement": "scenario",
            "version": "v1",
            "description": "Scenario with 7 additional modules in 1 tower",
            "extra_storage_capacity_kWh": 19.6,
            "extra_charging_power_kW": 12.08
        },
        "14_modules_2_towers": {
            "name": "14_modules_2_towers",
            "measurement": "scenario",
            "version": "v1",
            "description": "Scenario with 14 additional modules in 2 towers",
            "extra_storage_capacity_kWh": 39.2,
            "extra_charging_power_kW": 6.72
        }
    }
