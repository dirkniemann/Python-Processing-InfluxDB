{
    "mqtt": {
        "enabled": false,
        "host": "192.168.178.124",
        "port": 1883,
        "tls": false,
        "username_env": "MQTT_USERNAME",
        "password_env": "MQTT_PASSWORD",
        "client_id": "python-processing-dev",
        "topic_prefix": "python-processing",
        "discovery_prefix": "homeassistant",
        "qos": 1,
        "keepalive": 30,
        "connect_timeout_seconds": 5,
        "publish_timeout_seconds": 5,
        "retries": 2
    },
    "processing": {
        "input_bucket": "HomeAssistant",
        "output_bucket": "HomeAssistant_processed",
        "entities_to_process": {
            "fix_waermepumpe_stromverbrauch": {
                "version": "v1",
                "output_measurement": "fix_waermepumpe_stromverbrauch",
                "entities": [
                    "e3_vitocal_heizung_stromverbrauch_heute",
                    "e3_vitocal_heizung_stromverbrauch_heute_2"
                ]
            },
            "daily_aggregate": {
                "output_measurement": "Waermepumpe_statistik",
                "output_entity_id": "Gesamt",
                "version": "v1",
                "entities": [
                    "e3_vitocal_heizung_stromverbrauch_heute",
                    "e3_vitocal_heizung_stromverbrauch_heute_2"
                ]
            },
            "Waermepumpe_statistik": {
                "version": "v1",
                "source_version": "v1",
                "compressor_post_run_minutes": 15,
                "emit_daily_summary": true,
                "output_measurement": "Waermepumpe_statistik",
                "output_entity_id": "Gesamt",
                "sensors": {
                    "heat_pump_1_counter": {
                        "measurement": "kWh",
                        "entity_id": "e3_vitocal_heizung_stromverbrauch_heute",
                        "field": "value",
                        "unit": "kWh"
                    },
                    "heat_pump_2_counter": {
                        "measurement": "kWh",
                        "entity_id": "e3_vitocal_heizung_stromverbrauch_heute_2",
                        "field": "value",
                        "unit": "kWh"
                    },
                    "grid_power": {
                        "measurement": "W",
                        "entity_id": "fems_gridactivepower",
                        "field": "value",
                        "unit": "W"
                    },
                    "compressor_1": {
                        "measurement": "binary_sensor.e3_vitocal_kompressor",
                        "entity_id": "e3_vitocal_kompressor",
                        "field": "value",
                        "unit": "state"
                    },
                    "compressor_2": {
                        "measurement": "binary_sensor.e3_vitocal_kompressor_2",
                        "entity_id": "e3_vitocal_kompressor_2",
                        "field": "value",
                        "unit": "state"
                    }
                }
            },
            "corrected_house_consumption": {
                "version": "v1",
                "interval_seconds": 90,
                "output_measurement": "Hausverbrauch_korrigiert",
                "output_entity_id": "Hausverbrauch_korrigiert",
                "sources": {
                    "fems_house_consumption": {
                        "bucket": "HomeAssistant",
                        "measurement": "W",
                        "entity_id": "elektrischer_verbrauch",
                        "field": "value",
                        "change_only": true
                    }
                }
            }
        }
    },
    "scenarios": {
        "version": "v4",
        "buckets": {
            "source_bucket": "HomeAssistant",
            "processing_bucket": "HomeAssistant_processed",
            "output_bucket": "testing"
        },
        "setup": {
            "base_capacity_kwh": 22.4,
            "base_charge_power_dc_kw": 17.92,
            "base_discharge_power_dc_kw": 17.92,
            "min_soc_pct": 5,
            "max_soc_pct": 100,
            "initial_soc_pct": 5,
            "loss_model": "idealized_no_additional_losses_v1",
            "charge_efficiency": 1.0,
            "discharge_efficiency": 1.0
        },
        "sources": {
            "corrected_house_load": {
                "bucket_ref": "processing_bucket",
                "measurement": "Hausverbrauch_korrigiert",
                "entity_id": "Hausverbrauch_korrigiert",
                "field": "value",
                "version": "v1",
                "change_only": true
            },
            "fems_pv": {
                "bucket_ref": "source_bucket",
                "measurement": "W",
                "entity_id": "fems_productiondcactualpower",
                "field": "value",
                "change_only": true
            },
            "mt_stall_neu": {
                "bucket_ref": "source_bucket",
                "measurement": "W",
                "entity_id": "mt_stall_neu_leistung_ac_fixed",
                "field": "value",
                "change_only": true
            },
            "mt_stall_alt_1": {
                "bucket_ref": "source_bucket",
                "measurement": "W",
                "entity_id": "mt_stall_alt_1_leistung_ac_fixed",
                "field": "value",
                "change_only": true
            },
            "mt_stall_alt_2": {
                "bucket_ref": "source_bucket",
                "measurement": "W",
                "entity_id": "mt_stall_alt_2_leistung_ac_fixed",
                "field": "value",
                "change_only": true
            }
        },
        "pv_sources": {
            "local_pv": ["fems_pv", "mt_stall_neu"],
            "old_pv": ["mt_stall_alt_1", "mt_stall_alt_2"]
        },
        "pv_modes": {
            "without_old_pv": ["local_pv"],
            "with_old_pv": ["local_pv", "old_pv"]
        },
        "validation": {
            "battery_power": {
                "bucket_ref": "source_bucket",
                "measurement": "W",
                "entity_id": "fems_essdischargepower",
                "field": "value",
                "change_only": true
            },
            "battery_soc": {
                "bucket_ref": "source_bucket",
                "measurement": "„%“",
                "entity_id": "fems_esssoc",
                "field": "value",
                "change_only": true
            }
        },
        "quality": {
            "enabled": true,
            "grid_power": {
                "bucket_ref": "source_bucket",
                "measurement": "W",
                "entity_id": "fems_gridactivepower",
                "field": "value",
                "change_only": true
            }
        },
        "efficiency": {
            "enabled": true
        },
        "definitions": {
            "current_battery": {
                "enabled": true,
                "extra_capacity_kwh": 0,
                "extra_power_kw": 0
            },
            "8_modules_2_towers": {
                "enabled": false,
                "extra_capacity_kwh": 22.4,
                "extra_power_kw": 0
            },
            "7_modules_1_tower": {
                "enabled": false,
                "extra_capacity_kwh": 19.6,
                "extra_power_kw": 12.08
            },
            "14_modules_2_towers": {
                "enabled": false,
                "extra_capacity_kwh": 39.2,
                "extra_power_kw": 6.72
            }
        }
    }
}
